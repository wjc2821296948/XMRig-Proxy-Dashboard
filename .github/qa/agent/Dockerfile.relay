FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10002 --no-create-home --shell /usr/sbin/nologin relay \
    && mkdir -p /app
COPY --chown=10002:10002 litellm_relay.py /app/litellm_relay.py
USER 10002:10002
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["python", "/app/litellm_relay.py"]
