FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/home/qa \
    BROWSER_USE_SETUP_LOGGING=false \
    ANONYMIZED_TELEMETRY=false

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin qa \
    && mkdir -p /app /ms-playwright \
    && python -m pip install --no-cache-dir --upgrade pip

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && python -m playwright install --with-deps chromium \
    && chown -R 10001:10001 /home/qa /app

COPY --chown=10001:10001 run_explorer.py mock_proxy.py /app/
WORKDIR /app
USER 10001:10001

ENTRYPOINT ["python", "/app/run_explorer.py"]
